# ==============================================================================
# Double Alpha Fitness Gym - Frontend Environment Variables
# ==============================================================================

# 1. Laravel Backend API (Deployed on Railway)
# Local Dev: Leave empty or set to '/api' (proxied via vite.config.js)
# Vercel Production: Set to your live Railway domain, e.g.:
# VITE_API_BASE_URL=https://your-laravel-service.up.railway.app/api
VITE_API_BASE_URL=

# 2. Local AI Vision & Gesture Engine (Running on the Gym Counter PC)
# Defaults to http://127.0.0.1:5000
VITE_AI_URL=http://127.0.0.1:5000
