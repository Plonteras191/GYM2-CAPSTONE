# Copy to "Gesture Engine/.env" (git-ignored) and fill in. Real environment
# variables override these values.

# Laravel API the engine reports to.
LARAVEL_API_URL=http://127.0.0.1:8000/api

# Must match AI_ENGINE_TOKEN in backend/.env. If left empty, the engine reads
# it from ../backend/.env automatically (same-machine setup).
AI_ENGINE_TOKEN=

# Camera streams. These URLs contain camera passwords: never commit them.
# Hikvision main stream (720p) and low-latency sub-stream for data collection.
CCTV_URL=rtsp://USER:PASSWORD@CAMERA_IP:554/Streaming/Channels/101
CCTV_COLLECT_URL=rtsp://USER:PASSWORD@CAMERA_IP:554/Streaming/Channels/102
# Optional extra cameras.
CCTV_2_URL=
CCTV_3_URL=
PHONE_CAMERA_URL=rtsp://PHONE_IP:8554/live

# Starting source: cctv, cctv_2, cctv_3, webcam or phone.
CAMERA_SOURCE=phone
WEBCAM_INDEX=0
# Higher resolution keeps distant people detectable.
WEBCAM_WIDTH=1280
WEBCAM_HEIGHT=720

# Network address the engine listens on. 127.0.0.1 = this computer only.
# Use 0.0.0.0 only if other devices on the LAN must open the camera feeds.
AI_ENGINE_HOST=127.0.0.1
AI_ENGINE_PORT=5000

# Face recognition tuning (calibrate with: python scripts/eval_faces.py).
# Max face distance to accept a match. Lower = stricter (fewer wrong names,
# more "Unknown"). Typical range 0.42-0.55.
FACE_MATCH_THRESHOLD=0.50
# Required distance gap between the best and second-best *different* member.
FACE_MATCH_MARGIN=0.05
# Faces smaller than this many pixels are not recognized ("Move closer");
# the tracked body keeps the member's name instead.
FACE_MIN_SIZE=40
# Faces between FACE_MIN_SIZE and FACE_NEAR_SIZE count as "far": enlarged
# before encoding, stricter threshold and more agreeing checks needed.
FACE_NEAR_SIZE=70
FACE_FAR_THRESHOLD=0.45
FACE_FAR_VOTES=5
# Agreeing samples needed before a name is shown and attendance is logged.
FACE_VOTES_REQUIRED=3
# Re-samples per enrolled view (slower first sync, steadier matching; cached).
FACE_ENROLL_JITTERS=5

# Gesture Monitor (only members with an active coach membership are shown).
# Pose model: full = more accurate for distant people; lite = lighter CPU load.
POSE_MODEL=full
# Seconds a tracked body keeps a member's name without seeing the face again.
IDENTITY_MAX_UNCONFIRMED=120
# Body motion (torso lengths over ~1.5s) below which "Not moving" is shown.
MOTION_MIN=0.15
# Exercises checked even when the body is still (comma-separated).
STATIC_EXERCISES=PLANK

# Attendance anti-spoofing: when true, a recognized member is checked in only
# after the camera sees them blink (a printed photo never blinks). It does
# not stop a video played on a phone. Test it on your camera before turning
# it on for the gym: faces under FACE_NEAR_SIZE cannot be checked and show
# "COME CLOSER".
LIVENESS_REQUIRED=false
