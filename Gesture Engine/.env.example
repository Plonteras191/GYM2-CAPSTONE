# Copy to "Gesture Engine/.env" (git-ignored) and fill in. Real environment
# variables override these values.

# Laravel API the engine reports to.
LARAVEL_API_URL=http://127.0.0.1:8000/api

# Must match AI_ENGINE_TOKEN in backend/.env. If left empty, the engine reads
# it from ../backend/.env automatically (same-machine setup).
AI_ENGINE_TOKEN=

# Camera streams. These URLs contain camera passwords: never commit them.
# Hikvision main stream (720p) and low-latency sub-stream for data collection.
CCTV_URL=rtsp://USER:PASSWORD@CAMERA_IP:554/Streaming/Channels/101
CCTV_COLLECT_URL=rtsp://USER:PASSWORD@CAMERA_IP:554/Streaming/Channels/102
# Optional extra cameras.
CCTV_2_URL=
CCTV_3_URL=
PHONE_CAMERA_URL=rtsp://PHONE_IP:8554/live

# Starting source: cctv, cctv_2, cctv_3, webcam or phone.
CAMERA_SOURCE=phone
WEBCAM_INDEX=0

# Camera frames wider than this are shrunk on arrival (the Reolink sends 4K).
# 1280 = fastest. Try 1920 if faces far from the camera are not recognised and
# the video stays smooth.
MAX_FRAME_WIDTH=1280

# Run face recognition in its own process so it cannot freeze the video.
# Set to false only if the engine prints a warning about the face process.
FACE_RECOGNITION_IN_PROCESS=true

# Width of the video sent to the browser (Security / Gesture pages).
VIDEO_FEED_WIDTH=960

# Smallest face width (pixels) sent to face recognition. Smaller faces are
# still tracked. Lower it if members far from the camera are never recognised.
MIN_RECOGNITION_FACE_PX=48

# DEVELOPMENT ONLY: false lets anyone who can reach the engine switch cameras
# without an admin login. Keep it true for real deployment.
REQUIRE_ADMIN_TO_SWITCH_CAMERA=true

# Network address the engine listens on. 127.0.0.1 = this computer only.
# Use 0.0.0.0 only if other devices on the LAN must open the camera feeds.
AI_ENGINE_HOST=127.0.0.1
AI_ENGINE_PORT=5000
