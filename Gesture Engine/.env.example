# Copy to "Gesture Engine/.env" (git-ignored) and fill in. Real environment
# variables override these values.

# Laravel API the engine reports to.
LARAVEL_API_URL=http://127.0.0.1:8000/api

# Must match AI_ENGINE_TOKEN in backend/.env. If left empty, the engine reads
# it from ../backend/.env automatically (same-machine setup).
AI_ENGINE_TOKEN=

# Camera streams. These URLs contain camera passwords: never commit them.
# Hikvision main stream (720p) and low-latency sub-stream for data collection.
CCTV_URL=rtsp://USER:PASSWORD@CAMERA_IP:554/Streaming/Channels/101
CCTV_COLLECT_URL=rtsp://USER:PASSWORD@CAMERA_IP:554/Streaming/Channels/102
# Optional extra cameras.
CCTV_2_URL=
CCTV_3_URL=
PHONE_CAMERA_URL=rtsp://PHONE_IP:8554/live

# Starting source: cctv, cctv_2, cctv_3, webcam or phone.
CAMERA_SOURCE=phone
WEBCAM_INDEX=0
# Higher resolution keeps distant people detectable.
WEBCAM_WIDTH=1280
WEBCAM_HEIGHT=720

# Network address the engine listens on. 127.0.0.1 = this computer only.
# Use 0.0.0.0 only if other devices on the LAN must open the camera feeds.
AI_ENGINE_HOST=127.0.0.1
AI_ENGINE_PORT=5000

# Face recognition tuning (calibrate with: python scripts/eval_faces.py).
# Recognition uses SFace (models downloaded by scripts/download_face_models.py).
# Distances are 1 - cosine: 0 = identical, about 1 = unrelated faces. Values
# tuned for the old dlib model do NOT carry over.
# Max face distance to accept a match. Lower = stricter (fewer wrong names,
# more "Unknown"). Typical range 0.45-0.60.
FACE_MATCH_THRESHOLD=0.55
# Required distance gap between the best and second-best *different* member.
FACE_MATCH_MARGIN=0.08
# Keeping a name is easier than getting one: a face already confirmed as a
# member keeps the name while it stays within this looser limit (head turned
# to the side).
FACE_KEEP_THRESHOLD=0.62
# A confirmed face lost (e.g. full side view) and found again near the same
# spot within this many seconds is re-identified with one agreeing check.
REACQUIRE_SECONDS=6
# Enrolled views of a member (with 3+ views) that must match before a face
# counts for them. 2 stops strangers matching one turned side view; 1 = off.
FACE_MIN_AGREEING_VIEWS=2
# Faces smaller than this many pixels are not recognized ("Move closer");
# the tracked body keeps the member's name instead.
FACE_MIN_SIZE=40
# Faces between FACE_MIN_SIZE and FACE_NEAR_SIZE count as "far": enlarged
# before encoding, stricter threshold and more agreeing checks needed.
FACE_NEAR_SIZE=70
# Small-face search: the main detector misses faces under ~70 px, so while
# someone in view is not identified yet, YuNet looks for small faces every
# SMALL_FACE_SWEEP_SECONDS on a frame scaled to SMALL_FACE_SWEEP_WIDTH
# (960 finds faces down to ~40 px in ~36 ms). Costs nothing when everyone in
# view is identified.
SMALL_FACE_SWEEP_SECONDS=0.4
SMALL_FACE_SWEEP_WIDTH=960

# CPU / heat. The face and skeleton loops process at most AI_MAX_FPS frames
# per second whatever the camera sends. A face with UNKNOWN_BACKOFF_AFTER
# unmatched checks in a row (not a member: staff, visitors) is re-checked
# every RECOGNITION_INTERVAL_UNKNOWN seconds instead of every 0.2 s.
# Measured with one unknown person on a 30 fps camera: 2.9 -> 0.7 CPU cores.
AI_MAX_FPS=10
UNKNOWN_BACKOFF_AFTER=6
RECOGNITION_INTERVAL_UNKNOWN=1.5
FACE_FAR_THRESHOLD=0.50
FACE_FAR_VOTES=5
# Agreeing samples needed before a name is shown and attendance is logged.
FACE_VOTES_REQUIRED=3
# Helper processes that encode faces (~30 ms per face each), so several faces
# are encoded at once and the face loop never waits. 0 = encode inside the
# engine.
FACE_ENCODER_PROCESSES=2

# Gesture Monitor (only members with an active coach membership are shown).
# Pose model: full = more accurate for distant people; lite = lighter CPU load.
POSE_MODEL=full
# Seconds a tracked body keeps a member's name without seeing the face again.
IDENTITY_MAX_UNCONFIRMED=120
# Body motion (torso lengths over ~1.5s) below which "Not moving" is shown.
MOTION_MIN=0.15
# Exercises checked even when the body is still (comma-separated).
STATIC_EXERCISES=PLANK
# Exercises whose repetitions are counted from joint angles (comma-separated).
# Supported: SQUAT, PUSH UP, CURL, SIT UP; empty = all four. A task for one of
# these is verified only once its sets x reps have been counted. Other
# exercises are verified as soon as the camera recognizes them.
REP_EXERCISES=SQUAT,PUSH UP,CURL,SIT UP

# Attendance anti-spoofing: when true, a recognized member is checked in only
# after the camera sees them blink (a printed photo never blinks). It does
# not stop a video played on a phone. Test it on your camera before turning
# it on for the gym: faces under FACE_NEAR_SIZE cannot be checked and show
# "COME CLOSER".
LIVENESS_REQUIRED=false
