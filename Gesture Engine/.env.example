# Copy this file to ".env" (same folder) and fill in the real values.
# ".env" is git-ignored — never commit real passwords.

# Laravel API
LARAVEL_API_URL=http://127.0.0.1:8000/api
# Must be identical to AI_SERVICE_KEY in backend/.env
AI_SERVICE_KEY=

# Hikvision CCTV (or set CCTV_URL to a full rtsp:// URL instead)
CCTV_USER=admin
CCTV_PASSWORD=
CCTV_HOST=192.168.1.45
CCTV_PORT=554
CCTV_CHANNEL=101

# 'cctv' or 'webcam'
CAMERA_SOURCE=cctv
WEBCAM_INDEX=0
