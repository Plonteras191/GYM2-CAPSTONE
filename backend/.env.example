APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Use smtp for real recovery and login verification email delivery. The log driver never sends email.
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"
# Local development only: display random verification PINs instead of sending email.
# Leave unset in production and configure SMTP for email verification.
# AUTH_VERIFICATION_MODE=display_pin
# For Gmail SMTP, use the administrator Gmail and a Google App Password:
# MAIL_MAILER=smtp
# MAIL_HOST=smtp.gmail.com
# MAIL_PORT=587
# MAIL_USERNAME=your-admin@gmail.com
# MAIL_PASSWORD=your-google-app-password
# MAIL_ENCRYPTION=tls

# Shared secret for the Python Gesture Engine (/api/ai/* routes). Required.
# Generate one with: php -r "echo bin2hex(random_bytes(32));"
# The engine reads it from its AI_ENGINE_TOKEN env var, or from this file.
AI_ENGINE_TOKEN=

# Admin login tokens expire after this many minutes (default 720 = 12 hours).
SANCTUM_TOKEN_EXPIRATION=720

# First admin account created by `php artisan db:seed` (only if no admin exists).
# Leave ADMIN_PASSWORD empty to have a strong random password generated and printed.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
